{
	"name": "coolqr",
	"version": "2.1.0",
	"author": "nazmirket",
	"description": "This is a custom QR code generator.",
	"main": "dist/CoolQR.js",
	"types": "dist/CoolQR.d.ts",
	"files": [
		"CHANGELOG.MD",
		"dist",
		"README.MD"
	],
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "rimraf dist && tsc",
		"lint": "eslint .",
		"test": "npm run build && node --test tests/*.test.cjs && npm run test:types",
		"test:types": "tsc -p tests/tsconfig.json",
		"verify": "npm run lint && npm test",
		"prepack": "npm run build",
		"prepublishOnly": "npm run verify",
		"release": "npm publish"
	},
	"keywords": [
		"qr",
		"qrcode",
		"qr-code"
	],
	"license": "ISC",
	"dependencies": {
		"konva": "^9.2.0",
		"qrcode": "^1.5.3"
	},
	"devDependencies": {
		"@tsconfig/node18": "^2.0.0",
		"@types/node": "^18.16.3",
		"@types/qrcode": "^1.5.1",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-n": "^16.6.2",
		"eslint-plugin-prettier": "^5.5.4",
		"prettier": "^3.6.2",
		"rimraf": "^5.0.0",
		"typescript": "^5.0.4"
	}
}
