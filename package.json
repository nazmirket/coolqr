{
	"name": "coolqr",
	"version": "3.2.0",
	"author": "nazmirket",
	"description": "Dependency-free QR Code Model 2 encoder and browser canvas renderer.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"CHANGELOG.MD",
		"dist",
		"README.MD"
	],
	"packageManager": "pnpm@9.15.9",
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
		"lint": "eslint .",
		"test": "npm run build && node --test tests/*.test.cjs && npm run test:types",
		"test:types": "tsc -p tests/tsconfig.json",
		"verify": "npm run lint && npm test",
		"prepack": "npm run build",
		"prepublishOnly": "npm run verify",
		"release": "npm publish",
		"agents:check": "mirket project doctor --project . && node --test scripts/harness.node.mjs"
	},
	"keywords": [
		"qr",
		"qrcode",
		"qr-code"
	],
	"license": "ISC",
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.0.0",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-n": "^18.4.1",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"overrides": {
			"brace-expansion@^1.1.7": "1.1.21",
			"brace-expansion@^2.0.0": "2.1.7",
			"js-yaml@^4.0.0": "4.3.2",
			"minimatch@^9.0.0": "9.0.9"
		}
	}
}
